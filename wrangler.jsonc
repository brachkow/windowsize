{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "windowsize",
  "compatibility_date": "2026-07-21",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "windowsize.brachkow.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
